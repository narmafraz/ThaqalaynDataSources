{
  "verse_path": "/books/al-kafi:4:3:28:19",
  "phase1_raw": "{\n  \"has_chain\": true,\n  \"tags\": [\n    \"dua\",\n    \"afterlife\",\n    \"worship\"\n  ],\n  \"content_type\": \"theological\",\n  \"chunks\": [\n    {\n      \"chunk_type\": \"isnad\",\n      \"arabic_text\": \"عَلِيُّ بْنُ إِبْرَاهِيمَ عَنْ أَبِيهِ عَنِ ابْنِ فَضَّالٍ عَنِ الرِّضَا ( عليه السلام ) قَالَ\",\n      \"translations\": {\n        \"en\": \"Ali ibn Ibrahim, from his father, from Ibn Fazal, from Al-Reza (peace be upon him), said:\"\n      }\n    },\n    {\n      \"chunk_type\": \"body\",\n      \"arabic_text\": \"سَمِعْتُهُ يَقُولُ مَا وَقَفَ أَحَدٌ فِي تِلْكَ الْجِبَالِ إِلَّا اسْتُجِيبَ لَهُ فَأَمَّا الْمُؤْمِنُونَ فَيُسْتَجَابُ لَهُمْ فِي آخِرَتِهِمْ وَ أَمَّا الْكُفَّارُ فَيُسْتَجَابُ لَهُمْ فِي دُنْيَاهُمْ\",\n      \"translations\": {\n        \"en\": \"I heard him (peace be upon him) saying: 'No one would pause in those mountains except that it (his supplication) would be Answered for him. So, as for the Believers, it would be Answered for them in their Hereafter, and as for the Infidel, so it would be Answered for them in their world'.\"\n      }\n    }\n  ],\n  \"translations\": {\n    \"en\": {\n      \"summary\": \"Imam Al-Reza (peace be upon him) explains that supplications made while standing in the mountains during Hajj are always answered, but the timing differs based on the supplicant's faith. Believers receive their reward in the Hereafter, while disbelievers receive it in this worldly life.\",\n      \"seo_question\": \"When are supplications made in the mountains answered for believers versus disbelievers?\",\n      \"key_terms\": {\n        \"الْمُؤْمِنُونَ\": \"The Believers\",\n        \"الْكُفَّارُ\": \"The Infidels/Disbelievers\",\n        \"آخِرَتِهِمْ\": \"Their Hereafter\",\n        \"دُنْيَاهُمْ\": \"Their world/earthly life\",\n        \"اسْتُجِيبَ\": \"It was answered (passive verb for du'a)\"\n      }\n    }\n  },\n  \"related_quran\": [\n    {\n      \"ref\": \"2:186\",\n      \"relationship\": \"t